# ── Database (Supabase Postgres) ─────────────────────────────────────────
# Pooled connection (port 6543) — used by the app at runtime.
DATABASE_URL="postgresql://postgres:[PASSWORD]@[PROJECT].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) — used by `prisma migrate`.
DIRECT_URL="postgresql://postgres:[PASSWORD]@[PROJECT].supabase.com:5432/postgres"

# ── Sessions ──────────────────────────────────────────────────────────────
# REQUIRED, ≥32 chars — the app throws on boot without it.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""

# ── App URL ───────────────────────────────────────────────────────────────
# Used for share links / reset links generated outside a request context.
NEXT_PUBLIC_APP_URL="http://localhost:3002"

# ── Email (Resend) ────────────────────────────────────────────────────────
# Without RESEND_API_KEY, emails stay honestly "queued" (nothing sends).
# RESEND_FROM_ADDRESS must be on a domain verified in the Resend dashboard.
RESEND_API_KEY=""
RESEND_FROM_ADDRESS="Fence Quote Pros <quotes@fencequotepros.com>"

# ── File storage ──────────────────────────────────────────────────────────
# "local" (dev, writes under .data/) or "supabase" (prod).
STORAGE_DRIVER="local"
SUPABASE_URL=""
# service_role key — server-side ONLY, bypasses RLS. Never expose client-side.
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="uploads"

# ── AI fence visualization (optional) ─────────────────────────────────────
# Replicate FLUX-Fill; ~$0.05/image. Feature is skipped without a token.
REPLICATE_API_TOKEN=""
VISUALIZATION_PROVIDER="replicate"

# ── Ordinance scraper (optional, scripts/scrape-ordinance.mjs) ────────────
FIRECRAWL_API_KEY=""

# ── Access ────────────────────────────────────────────────────────────────
# Signups are CLOSED by default (private beta). Set "1" to open public
# signups at launch. Existing accounts can always log in.
SIGNUPS_OPEN=""

# ── Safety valves (leave unset in production) ─────────────────────────────
# "1" lets signup claim passwordless legacy accounts (account-takeover risk;
# only enable for a controlled migration).
ALLOW_ACCOUNT_CLAIM=""
# "1" downgrades permit-PDF field-mapping mismatches from hard errors to
# warnings (debugging new county form revisions only).
PERMIT_FILL_LENIENT=""
